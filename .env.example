# LLM (OpenRouter, OpenAI-compatible API)
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-3.8-flash

# Observability (optional: leave empty to disable tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Vector store
QDRANT_URL=http://localhost:6333

# Optional: raises GitHub rate limits
GITHUB_TOKEN=

